# Copy to .env locally. Never commit a filled .env.
# mock: synthetic demo. iacpaas: configured real resources, read-only.
IACPAAS_BACKEND=mock
IACPAAS_ALLOW_WRITES=0
IACPAAS_WRITABLE_PREFIX=/demo/

# HTTP transport only: choose a random local token, keep out of git.
MCP_HTTP_TOKEN=

# Web application model: OpenRouter, separate from Hermes credentials.
# Exact ID verified against OpenRouter /api/v1/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Optional path to the official Codex CLI for ChatGPT subscription sign-in.
# Leave blank to discover codex on PATH or in the per-user app runtime.
# Login is performed separately for each browser owner in the web settings.
CODEX_BIN=

# Conservative application budgets, not the model's advertised context window.
AGENT_CONTEXT_LIMIT=48000
AGENT_OUTPUT_RESERVE=4096
AGENT_TOOL_RESULT_BYTES=8192
AGENT_SUMMARY_BYTES=2048
MCP_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8000/mcp

# Optional exact Host allowlist for LAN/reverse-proxy access, comma-separated.
# Loopback names are always allowed; wildcard, schemes and ports are rejected.
IACPAAS_TRUSTED_HOSTS=

# Optional legacy CLI model. Demo mode is NOT a real LLM.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Real IACPaaS: username/password -> private JWT. No administrator API key required.
# Set IACPAAS_BACKEND=iacpaas to use these resources; no silent fallback to mock.
IACPAAS_BASE_URL=https://iacpaas.dvo.ru
IACPAAS_USERNAME=""
IACPAAS_PASSWORD=""
IACPAAS_GASES_PATH=""
IACPAAS_GASES_ONTOLOGY_PATH=""
IACPAAS_SUBSTANCES_PATH=""
IACPAAS_SUBSTANCES_ONTOLOGY_PATH=""
IACPAAS_UNITS_PATH=""
IACPAAS_CHARACTERISTICS_ONTOLOGY_PATH=""
IACPAAS_PROPERTIES_PATH=""
IACPAAS_PROPERTIES_ONTOLOGY_PATH=""
IACPAAS_TERMS_PATH=""
IACPAAS_EXPORT_BYTES=16777216
IACPAAS_CACHE_SECONDS=60
