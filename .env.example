# Copy to .env locally. Never commit a filled .env.
# MOCK is the only connected backend in this version.
IACPAAS_BACKEND=mock
IACPAAS_ALLOW_WRITES=0
IACPAAS_WRITABLE_PREFIX=/demo/

# HTTP transport only: choose a random local token, keep out of git.
MCP_HTTP_TOKEN=

# Optional real LLM. Demo mode requires no account/key and is NOT a real LLM.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Reserved for the later real IACPaaS adapter; not used in mock mode.
IACPAAS_BASE_URL=
IACPAAS_API_KEY=
